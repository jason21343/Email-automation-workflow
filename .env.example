# Copy this file to .env and replace every placeholder locally.
TZ=Asia/Taipei
N8N_VERSION=latest
N8N_SANDBOX_VERSION=latest
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_PUBLIC_URL=http://localhost:5678
N8N_EDITOR_BASE_URL=http://localhost:5678
WEBHOOK_URL=http://localhost:5678
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true

N8N_ENABLED_MODULES=instance-ai
N8N_COMMUNITY_PACKAGES_ALLOW_TOOL_USAGE=true
N8N_RUNNERS_ENABLED=true
N8N_RUNNERS_MODE=internal
N8N_INSTANCE_AI_MODEL=openai/YOUR_OLLAMA_MODEL
N8N_INSTANCE_AI_MODEL_PROVIDER=openai
N8N_INSTANCE_AI_MODEL_URL=http://host.docker.internal:11434/v1
N8N_INSTANCE_AI_MODEL_API_KEY=ollama

N8N_INSTANCE_AI_SANDBOX_ENABLED=true
N8N_INSTANCE_AI_SANDBOX_PROVIDER=n8n-sandbox
N8N_SANDBOX_SERVICE_URL=http://sandbox-api:8080
N8N_SANDBOX_SERVICE_API_KEY=REPLACE_WITH_LOCAL_SECRET
N8N_INSTANCE_AI_SANDBOX_API_URL=http://sandbox-api:8080
N8N_INSTANCE_AI_SANDBOX_API_KEY=REPLACE_WITH_LOCAL_SECRET

SANDBOX_API_KEYS=REPLACE_WITH_LOCAL_SECRET
SANDBOX_CORS_ALLOWED_ORIGINS=http://localhost:5678
SANDBOX_API_AUTH_TOKEN=REPLACE_WITH_LOCAL_SECRET
SANDBOX_RUNNER_AUTH_TOKEN=REPLACE_WITH_LOCAL_SECRET
N8N_RUNNERS_AUTH_TOKEN=REPLACE_WITH_LOCAL_SECRET
APPROVAL_TOKEN=REPLACE_WITH_LOCAL_SECRET
APPROVAL_EMAIL=your-email@example.com
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=REPLACE_WITH_LOCAL_SECRET
SANDBOX_RUNNER_REGISTRATION_TOKEN=REPLACE_WITH_LOCAL_SECRET
